@ARTICLE{Farber2017,
title = {Employment, Hours, and Earnings Consequences of Job Loss: US Evidence from the Displaced Workers Survey},
author = {Farber, Henry S.},
year = {2017},
journal = {Journal of Labor Economics},
volume = {35},
number = {S1},
pages = {S235 - S272},
abstract = {Data are used from the 1984–2016 Displaced Workers Surveys (DWS) to investigate the incidence and consequences of job loss, 1981–2015. These data show a record high rate of job loss in the Great Recession, with serious employment consequences for job losers, including very low rates of re-employment and difficulty finding full-time employment. The average reduction in weekly earnings for job losers making a full-time–full-time transition are relatively small, with a substantial minority reporting earning more on their new job than on the lost job. Most of the cost of job loss comes from difficulty finding new full-time employment.},
url = {https://EconPapers.repec.org/RePEc:ucp:jlabec:doi:10.1086/692353}
}



